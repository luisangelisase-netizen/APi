        "\n",
        "dna = input()\n",
        "procurada = input()\n",
        "\n",
        "encontrada = False\n",
        "\n",
        "for i in range(len(dna) - len(procurada) + 1):\n",
        "    j = 0\n",
        "\n",
        "    while j < len(procurada) and dna[i + j] == procurada[j]:\n",
        "        j += 1\n",
        "\n",
        "    if j == len(procurada):\n",
        "        print(\"Sequência encontrada na posição\", i + 1)\n",
        "        encontrada = True\n",
        "        break\n",
        "\n",
        "if not encontrada:\n",
        "    print(\"Sequência não encontrada\")\n"
      ],
